{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NEEDS_HUMAN",
        "STUCK"
      ]
    },
    "tasks_done": {
      "type": "integer",
      "description": "Number of tasks completed in this pass, from 0 through 100000. The runtime discards negative or larger counts."
    },
    "tasks_skipped": {
      "type": "integer"
    },
    "tasks_needs_human": {
      "type": "integer"
    },
    "fixed_review_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs_human": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": ["gate", "product", "security", "human"]
              },
              "command": {
                "type": "string"
              }
            },
            "required": [
              "task_id",
              "reason"
            ]
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "task_id",
              "reason"
            ]
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string"
              },
              "what": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "task_id",
              "what",
              "why"
            ]
          }
        }
      },
      "required": [
        "needs_human",
        "skipped",
        "deviations"
      ]
    },
    "prose_notes": {
      "type": "string"
    },
    "insights": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 280
      }
    }
  },
  "required": [
    "status",
    "tasks_done",
    "tasks_skipped",
    "tasks_needs_human",
    "fixed_review_items",
    "notes",
    "prose_notes"
  ]
}
