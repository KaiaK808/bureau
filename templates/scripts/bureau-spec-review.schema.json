      "enum": [true, false, "true", "TRUE", "yes", "YES", "false", "FALSE", "no", "NO"]
    },
    "issues_found": {
      "type": "integer"
    },
    "issues_fixed": {
      "type": "integer"
    },
    "remaining_issues": {
