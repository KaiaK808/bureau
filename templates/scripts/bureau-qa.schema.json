{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "GREEN",
        "RED",
        "NEEDS_HUMAN"
      ]
    },
    "tests_added": {
      "type": "integer"
    },
    "tests_failing": {
      "type": "integer"
    },
    "coverage_notes": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["gate", "product", "security", "human"]},
          "command": {"type": "string"},
          "reason": {"type": "string"}
        },
        "required": ["kind", "command", "reason"]
      }
    }
  },
  "required": [
    "status",
    "tests_added",
    "tests_failing",
    "coverage_notes"
  ]
}
